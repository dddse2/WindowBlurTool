<Page
    x:Class="BlurTool.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <ScrollViewer>
        <StackPanel Margin="28,28,28,60" Spacing="18">
            <TextBlock Text="主页" Style="{ThemeResource TitleLargeTextBlockStyle}" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="StatusText" Text="当前状态：未模糊" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Text="目标进程" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="当前目标" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TargetProcessText" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ProcessCombo" Width="280" SelectionChanged="ProcessCombo_SelectionChanged" />
                        <Button Content="刷新" Click="RefreshProcesses_Click" />
                    </StackPanel>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE72E;" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="锁定目标进程快捷键" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="锁定 / 解除锁定当前目标" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ItemsControl
                            x:Name="LockHotkeyChips"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                        <TextBlock
                                            Text="{x:Bind}"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button
                            x:Name="EditLockHotkeyButton"
                            Grid.Column="3"
                            Click="EditLockHotkeyButton_Click"
                            Margin="12,0,0,0"
                            ToolTipService.ToolTip="修改快捷键">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>

            <TextBlock Text="激活" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE7EE;" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="全局模糊快捷键" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="开启 / 关闭前景窗口模糊" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ItemsControl
                        x:Name="HotkeyChips"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                    <TextBlock
                                        Text="{x:Bind}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button
                        x:Name="EditHotkeyButton"
                        Grid.Column="3"
                        Click="EditHotkeyButton_Click"
                        Margin="12,0,0,0"
                        ToolTipService.ToolTip="修改快捷键">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE7C4;" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="调整模糊范围快捷键" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="进入编辑模式调整模糊区域" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ItemsControl
                        x:Name="RegionHotkeyChips"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                    <TextBlock
                                        Text="{x:Bind}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button
                        x:Name="EditRegionHotkeyButton"
                        Grid.Column="3"
                        Click="EditRegionHotkeyButton_Click"
                        Margin="12,0,0,0"
                        ToolTipService.ToolTip="修改快捷键">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>

            <TextBlock x:Name="HotkeyTip" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />

            <TextBlock Text="模糊效果" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="模糊半径" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="BlurValueText" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Slider
                        x:Name="BlurSlider"
                        Minimum="0"
                        Maximum="150"
                        StepFrequency="1"
                        ValueChanged="BlurSlider_ValueChanged" />
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="刷新帧率" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FpsValueText" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Slider
                        x:Name="FpsSlider"
                        Minimum="5"
                        Maximum="60"
                        StepFrequency="1"
                        ValueChanged="FpsSlider_ValueChanged" />
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="模糊范围" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="EditRegionNowButton" Content="调整模糊范围" Click="EditRegionNowButton_Click" />
                        <Button x:Name="ResetRegionButton" Content="重置为全窗口" Click="ResetRegionButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button x:Name="BlurNowButton" Content="立即模糊当前前台窗口" Click="BlurNowButton_Click" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
